Group {
 name LN_LoopImage
 tile_color 0x5280ff
 note_font "Verdana Bold"
 selected true
 addUserKnob {20 User l Loop}
 addUserKnob {4 type l "Loop Direction" M {Horizontal Vertical}}
 addUserKnob {7 loopSpeed l "Loop Speed" R -100 300}
 loopSpeed 50
 addUserKnob {6 switchMirror l "Mirror Image" +STARTLINE}
 switchMirror true
 addUserKnob {26 ""}
 addUserKnob {26 about l "" +STARTLINE T "<b><font color=#d1b364>Created by Livia Nunes - 2020 - v1.0</font></b>"}
 addUserKnob {26 site l "" +STARTLINE T "Visit <a href=\"http://www.livialivialivia.com\"><span style=\"color:#C8C8C8;\"><b>www.livialivialivia.com</a></b> for more tools and content"}
}
