Group {
 name LN_EasyDistort
 tile_color 0x5280ff
 note_font Verdana
 selected true
 addUserKnob {20 User l Warp}
 addUserKnob {26 div_distortionSet l "<b><font color=#75adbd>Distortion Settings</font><b>"}
 addUserKnob {41 translate T Transform_stmap.translate}
 addUserKnob {41 skewX l "skew X" T Transform_stmap.skewX}
 addUserKnob {41 skewY l "skew Y" T Transform_stmap.skewY}
 addUserKnob {41 scale T Transform_stmap.scale}
 addUserKnob {41 rotate T Transform_stmap.rotate}
 addUserKnob {26 ""}
 addUserKnob {7 blurShape l "Distortion Falloff" R 0 500}
 blurShape 400
 addUserKnob {26 div_bbox l "" +STARTLINE}
 addUserKnob {41 center l "Distort Center" T Transform_stmap.center}
 addUserKnob {22 updateCenter l "Update Center to Input" -STARTLINE T "n = nuke.thisGroup()\n\ninput = n.input(0)\nif not input:\n    input = nuke.root()\n    \nwidth = input.width()\nheight = input.height()\n    \nn\['center'].setValue(\[width/2, height/2])"}
 addUserKnob {26 ""}
 addUserKnob {6 bbox l "Keep original BBox" +STARTLINE}
 bbox true
 addUserKnob {26 ""}
 addUserKnob {26 about l "" +STARTLINE T "<b><font color=#d1b364>Created by Livia Nunes - 2020 - v1.1</font></b>"}
 addUserKnob {26 site l "" +STARTLINE T "Visit <a href=\"http://www.livialivialivia.com\"><span style=\"color:#C8C8C8;\"><b>www.livialivialivia.com</a></b> for more tools and content"}
}
 Input {
  inputs 0
  name Src
  xpos -49
  ypos -252
 }
set N62d83c00 [stack 0]
 Dot {
  name Dot3
  xpos -14
  ypos 256
 }
set N62d83800 [stack 0]
