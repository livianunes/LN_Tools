set N985ba400 [stack 0]
 NoOp {
  name GetFormat_STMap
  note_font "Verdana Bold"
  xpos -378
  ypos -576
  addUserKnob {20 User}
  addUserKnob {3 width l w}
  width {{input.width}}
  addUserKnob {3 height l h -STARTLINE}
  height {{input.height}}
 }
 Reformat {
  type "to box"
  box_width {{parent.GetFormat_Proportional.knob.width}}
  box_height {{parent.GetFormat_Proportional.knob.height}}
  box_fixed true
  resize {{Reformat3.resize x1782016 2}}
  pbb true
  name Reformat2
  xpos -378
  ypos -341
  disable {{"GetFormat_STMap.width == GetFormat_Image.width && GetFormat_Image.height == GetFormat_STMap.height"}}
 }
