 }
push $N9dbe6000
 Crop {
  box {{input.bbox.x} {input.bbox.y} {input.bbox.r} {input.bbox.t}}
  reformat true
  crop false
  name BBoxFormat
  selected true
  xpos 411
  ypos -32
  addUserKnob {20 Maths}
  addUserKnob {14 originalFormat l "original format" R 0 100}
  originalFormat {{input.format.w} {input.format.h}}
  addUserKnob {15 differenceValues}
  differenceValues {{input.bbox.x-input.format.x} {input.bbox.y-input.format.y} {input.bbox.r-input.format.r} {input.bbox.t-input.format.t}}
  addUserKnob {15 restoreFormat}
  addUserKnob {7 ar R 1 3}
  ar {{input.format.pixel_aspect}}
 }
end_group
