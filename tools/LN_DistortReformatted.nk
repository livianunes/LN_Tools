Group {
 name LN_DistortReformatted
 tile_color 0x5280ff
 selected true
 xpos -289
 ypos 869
 addUserKnob {20 User l Lens}
 addUserKnob {26 div_config l "<b><font color=#75adbd>Settings</font><b>"}
 addUserKnob {26 s l " " T " "}
 addUserKnob {41 pbb l "preserve bounding box" T Reformat5.pbb}
 addUserKnob {41 black_outside l "black outside" -STARTLINE T Reformat5.black_outside}
 addUserKnob {26 space l "" +STARTLINE T " "}
 addUserKnob {26 div_reformat l "<b><font color=#75adbd>Reformated Image</font><b>"}
 addUserKnob {26 explain l "" +STARTLINE T "Choose what type of reformat was done the the original media:\n"}
 addUserKnob {41 resize l "resize type" t "This will only work with width or height types. " T Reformat3.resize}
 addUserKnob {26 space22 l " " T ""}
 addUserKnob {26 ""}
 addUserKnob {26 about l "" +STARTLINE T "<b><font color=#d1b364>Created by Livia Nunes - 2021 - v1.0</font></b>"}
 addUserKnob {26 site l "" +STARTLINE T "Visit <a href=\"http://www.livialivialivia.com\"><span style=\"color:#C8C8C8;\"><b>www.livialivialivia.com</a></b> for more tools and content"}
}
