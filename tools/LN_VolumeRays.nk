  fromInput2 {{1} B A}
  in2 rgba
  out2 negativeMask
  mappings "8 rgba.red 0 0 rgba.red 0 0 rgba.green 0 1 rgba.green 0 1 rgba.blue 0 2 rgba.blue 0 2 rgba.alpha 0 3 rgba.alpha 0 3 rgba.red 1 0 negativeMask.red 1 0 rgba.green 1 1 negativeMask.green 1 1 rgba.blue 1 2 negativeMask.blue 1 2 rgba.alpha 1 3 negativeMask.alpha 1 3"
  name Shuffle6
  xpos -382
  ypos -554
 }
