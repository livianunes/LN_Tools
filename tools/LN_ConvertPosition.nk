  xpos 164
  ypos 386
 }
 NoOp {
  inputs 0
  name _callbacks_
  knobChanged "ntn = nuke.thisNode()\ntype = ntn.knob('transf').value()\n\nif nuke.thisKnob().name() == 'transf':\n    \n        if type == 'cam to world' or type == 'world to cam':\n\n            nuke.thisParent().knob('explain').setVisible(False)\n            \n            with nuke.thisGroup():\n                \n                for i in nuke.allNodes('Input'):\n                    \n                    if i.name() ==  'src':\n                        pass     \n                        \n                    elif  i.name() == 'objLocatorAxis':\n                        i.knob('name').setValue('cam')\n                        \n                        \n        elif type == 'object to world' or type == 'world to object' :\n            \n                nuke.thisParent().knob('explain').setVisible(True)\n            \n                with nuke.thisGroup():\n                    \n                    for i in nuke.allNodes('Input'):\n                        \n                        if i.name() ==  'src':\n                            pass\n                            \n                        elif i.name() == 'cam':\n                            i.knob('name').setValue('objLocatorAxis')                "
  xpos -345
  ypos -338
  hide_input true
  addUserKnob {20 User}
  addUserKnob {4 transf l Transformation M {"cam to world" "object to world" "world to cam" "world to object" ""}}
  transf "object to world"
 }
 Input {
  inputs 0
  name objLocatorAxis
  xpos 1026
  ypos -353
  number 1
 }
 Axis2 {
  name Axis3
  xpos 1036
  ypos -269
 }
set N9186d800 [stack 0]
 NoOp {
  name camScale
  label "error handling"
  xpos 1026
  ypos -146
  addUserKnob {20 User}
  addUserKnob {13 scale}
  scale {{"NoOp1.uniform_scale == 0? 1: NoOp1.scale.x"} {"NoOp1.uniform_scale == 0? 1: NoOp1.scale.y"} {"NoOp1.uniform_scale == 0? 1: NoOp1.scale.z"}}
  addUserKnob {7 uniform_scale l "Uniform Scale" R 0 10}
  uniform_scale {{"NoOp1.uniform_scale == 0? 1:NoOp1.uniform_scale "}}
  addUserKnob {13 total_scale l "Total Scale"}
  total_scale {{"NoOp1.uniform_scale == 0? 1: NoOp1.total_scale.x"} {"NoOp1.uniform_scale == 0? 1 : NoOp1.total_scale.y"} {"NoOp1.uniform_scale == 0? 1: NoOp1.total_scale.z"}}
 }
push $N9186d800
 NoOp {
  name NoOp1
  label "camera scale"
  xpos 1153
  ypos -255
  addUserKnob {20 User}
  addUserKnob {13 scale}
  scale {{"\[value \[topnode parent.input1].scaling.x]"} {"\[value \[topnode parent.input1].scaling.y]"} {"\[value \[topnode parent.input1].scaling.z]"}}
  addUserKnob {7 uniform_scale l "uniform scale"}
  uniform_scale {{"\[value \[topnode parent.input1].uniform_scale]"}}
  addUserKnob {13 total_scale l "total scale"}
  total_scale {{"scale*uniform_scale ? 1/(scale*uniform_scale) : 0"} {"scale*uniform_scale ? 1/(scale*uniform_scale) : 0"} {"scale*uniform_scale ? 1/(scale*uniform_scale) : 0"}}
 }
end_group
