Group {
 name LN_ConvertPosition
 label "(\[value transf])"
 selected true
 tile_color 0x5280ff
 addUserKnob {20 SpaceTransform}
 addUserKnob {41 in l "pos channel" T Shuffle1.in}
 addUserKnob {41 out l output T ShuffleCopy1.out2}
 addUserKnob {4 data_type l "data type" M {"normal vectors" "point positions"}}
 data_type "point positions"
 addUserKnob {41 transf l Transformation T _callbacks_.transf}
 addUserKnob {26 explain l "" +STARTLINE T "You need an Axis node with the object animation to use this mode"}
 addUserKnob {26 ""}
 addUserKnob {26 about l "" +STARTLINE T "<b><font color=#d1b364>Created by Livia Nunes - 2021 - v1.0</font></b>\n"}
 addUserKnob {26 site l "" +STARTLINE T "Visit <a href=\"http://www.livialivialivia.com\"><span style=\"color:#C8C8C8;\"><b>www.livialivialivia.com</a></b> for more tools and content"}
 addUserKnob {26 thanks l "" +STARTLINE T "<font color=#757575 size=2>Thanks to Adrian Herr, this tool is very much based on his tool</font>"}
}
