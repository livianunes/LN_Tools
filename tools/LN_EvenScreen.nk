Group {
 name LN_EvenScreen
 knobChanged "\n\n#define variables\nntn = nuke.thisNode()\ng = nuke.thisGroup()\nk = nuke.thisKnob()\nscreenType = ntn.knob('screentype')\nIBKStack = ntn.knob('SwitchIBKStack')\nblursize = ntn.knob('Blur_size')\nmethod = ntn.knob('method')\noutput = ntn.knob('outputType')\nmatteType = ntn.knob('matteType')\ndarks = ntn.knob('darks')\nlights = ntn.knob('lights')\ndiffGain = ntn.knob('diffGain')\nluminance = ntn.knob('luminance')\nmatteErode = ntn.knob('matteErode')\nmatteBlack = ntn.knob('matteBlack')\nmatteWhite = ntn.knob('matteWhite')\ncalculate = ntn.knob('calculate')\ndiv_even = ntn.knob('div_even')\nshuffleClean= ntn.knob('shuffleCleanPlate')\ngradeES = ntn.knob('EScolor')\nIBK_screen = ntn.knob('screentype').getValue()\n\nif IBK_screen == 0:\n    IBK_screen = 1\nelse:\n    IBK_screen = 0\n\nif k.name() == 'screentype':\n\n    screentype = ntn.knob('screentype').getValue()\n    screentype = int(screentype)\n\n\n    if screentype != 2:\n        g.begin()\n        try:\n            nuke.toNode('Custom').knob('name').setValue('stencil')\n        except:\n            pass\n\n        nuke.toNode('QP_IBKColour1').knob('screen_type').setValue(screentype)\n        nuke.toNode('QP_IBKColour2').knob('screen_type').setValue(screentype)\n        nuke.toNode('QP_IBKColour3').knob('screen_type').setValue(screentype)\n        nuke.toNode('QP_IBKColour4').knob('screen_type').setValue(screentype)\n        nuke.toNode('QP_IBKColour5').knob('screen_type').setValue(screentype)\n        nuke.toNode('QP_IBKColour6').knob('screen_type').setValue(screentype)\n        nuke.toNode('QP_IBKColour7').knob('screen_type').setValue(screentype)\n        nuke.toNode('QP_IBKColour8').knob('screen_type').setValue(screentype)\n        nuke.toNode('QP_IBKColour9').knob('screen_type').setValue(screentype)\n        nuke.toNode('QP_IBKColour10').knob('screen_type').setValue(screentype)\n        nuke.toNode('QP_IBKColour11').knob('screen_type').setValue(screentype)\n        nuke.toNode('QP_IBKColour12').knob('screen_type').setValue(screentype)\n        nuke.toNode('IBKGizmoV3').knob('st').setValue(IBK_screen)\n        g.end()\n\n        darks = ntn.knob('darks').setVisible(True)\n        lights = ntn.knob('lights').setVisible(True)\n\n\n    else:\n        try:\n            nuke.toNode('stencil').knob('name').setValue('Custom')\n        except:\n            pass\n        darks = ntn.knob('darks').setVisible(False)\n        lights = ntn.knob('lights').setVisible(False)\n\nif k.name() == 'method':\n\n    if method.value() == 'Low_Quality':\n        IBKStack.setVisible(False)\n        blursize.setVisible(True)\n    else:\n        IBKStack.setVisible(True)\n        blursize.setVisible(False)\n\nif output.value() == 'Clean Plate':\n    diffGain.setVisible(False)\n    luminance.setVisible(False)\n    matteErode.setVisible(False)\n    matteBlack.setVisible(False)\n    matteWhite.setVisible(False)\n    calculate.setVisible(False)\n    matteType.setVisible(False)\n    div_even.setVisible(False)\n    gradeES.setVisible(False)\n    shuffleClean.setVisible(False)\n    ntn\['label'].setValue('CLEAN PLATE')\nelse:\n    matteType.setVisible(True)\n    div_even.setVisible(True)\n    calculate.setVisible(True)\n    gradeES.setVisible(True)\n    shuffleClean.setVisible(True)\n    ntn\['label'].setValue('EVEN SCREEN')\n\n    if matteType.value() == 'IBK':\n        diffGain.setVisible(False)\n        luminance.setVisible(True)\n        matteErode.setVisible(True)\n        matteBlack.setVisible(True)\n        matteWhite.setVisible(True)\n    else:\n        diffGain.setVisible(True)\n        luminance.setVisible(False)\n        matteErode.setVisible(True)\n        matteBlack.setVisible(True)\n        matteWhite.setVisible(True)\n\n"
 tile_color 0x5280ff
 label "CLEAN PLATE"
 note_font "Verdana Bold"
 selected true
 addUserKnob {20 User l EvenScreen}
 addUserKnob {26 div_clean l "<font color=#3a9154><b>Clean Plate Settings</font><b>"}
 addUserKnob {41 white l Pre-Grade T Grade_Inicial.white}
 addUserKnob {6 pregradeDisable l "Disable Pre-Grade" +STARTLINE}
 addUserKnob {4 screentype l "screen matte type" t "A pre-key that determines what is the green/bluescreen and what is not. You can add aditional masks in the Stencil pipe. Custom allows you to use some external key like a keylight to determine it.\n" M {"IBK - Green" "IBK - Blue" Custom "" "" "" "" "" "" "" "" "" ""}}
 addUserKnob {18 darks}
 darks {0 0 0}
 addUserKnob {6 darks_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {18 lights}
 lights {1 1 1}
 addUserKnob {6 lights_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {3 erode l Erode}
 addUserKnob {26 space2 l " " T " "}
 addUserKnob {4 method l Method t "IBK Stack for best quality. Low_quality for faster feedback, ideal for shot assembly, but can be enough for good results in some cases." M {"IBK Stack" Low_Quality "" "" "" "" "" "" "" "" "" ""}}
 addUserKnob {3 SwitchIBKStack l "IBK Stack" t "How many IBK colors in the stack (recommend around 7)"}
 addUserKnob {7 Blur_size l size +HIDDEN R 0 1000}
 Blur_size 150
 addUserKnob {26 space3 l " " T " "}
 addUserKnob {6 chk_frameHold l "Frame Hold Clean Plate" +STARTLINE}
 addUserKnob {3 frameHold l "Frame Hold"}
 frameHold 1001
 addUserKnob {26 div_out l "<font color=#3a9154><b>Output</font><b>"}
 addUserKnob {4 outputType l "Output Type" M {"Clean Plate" "Even Screen" "" ""}}
 addUserKnob {26 space5 l " " T " "}
 addUserKnob {26 div_even l "<b><font color=#3a9154>Even Screen Settings</font><b>" +HIDDEN}
 addUserKnob {6 chk_UseExternalCP l "Use External Clean Plate" +STARTLINE}
 addUserKnob {26 space_1 l " " T ""}
 addUserKnob {22 calculate l "Calculate Even Screen Color" +HIDDEN T "#calculate button\nntn = nuke.thisNode()\nscreentype = ntn.knob('screentype').getValue()\nscreentype = int(screentype)\nthisFrame = nuke.frame()\ng = nuke.thisGroup()\n\ng.begin()\ncurvetool = nuke.toNode('CurveTool1')\ncurvetool.knob('intensitydata').clearAnimated()\nnuke.executeMultiple(\[curvetool,], (\[thisFrame, thisFrame, 1],))\n\n#set proper setting in IBK gizmo when using Custom\nif screentype == 2:\n    data = curvetool.knob('intensitydata').value()\n    max_value = max(data)\n    max_index = data.index(max_value)\n    #red is max\n    if max_index == 0:\n        IBK_screen = 1\n    #green is max\n    elif max_index == 1:\n        IBK_screen = 1\n    #blue is max\n    elif max_index == 2:\n        IBK_screen = 0\n    nuke.toNode('IBKGizmoV3').knob('st').setValue(IBK_screen)\n\ng.end()\n" +STARTLINE}
 addUserKnob {18 EScolor l "Adjust BG Color" +HIDDEN R -1 2}
 EScolor {1 1 1}
 addUserKnob {6 EScolor_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {26 space l " " T " "}
 addUserKnob {6 evenColorGain_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 evenColorGain_panelDropped true
 addUserKnob {6 even_color_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {4 matteType l "Matte Type" +HIDDEN M {IBK Difference "" "" ""}}
 addUserKnob {6 luminance l "luminance match" +HIDDEN +STARTLINE}
 addUserKnob {7 diffGain l "Difference Gain" +HIDDEN R 0 400}
 diffGain 100
 addUserKnob {7 matteBlack l "Matte Blackpoint" +HIDDEN}
 addUserKnob {7 matteWhite l "Matte Whitepoint" +HIDDEN}
 matteWhite 1
 addUserKnob {6 test_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {7 matteErode l Erode +HIDDEN R -1 10}
 addUserKnob {22 shuffleCleanPlate l "Shuffle Out Clean Plate" t "Creates a shuffle that outputs the clean plate" +HIDDEN T "import nukescripts\n\nntn = nuke.thisNode()\n#get pos\nyPos = ntn.ypos()\nxPos = ntn.xpos()\n\nr = nuke.root()\nr.begin()\nnukescripts.clear_selection_recursive()\nshuffle = nuke.createNode('Shuffle')\nshuffle\['in'].setValue('cleanplate')\nshuffle.setInput(0, ntn)\nshuffle\['label'].setValue('CLEAN_PLATE')\nshuffle\['xpos'].setValue(xPos+200)\nr.end()\n" +STARTLINE}
 addUserKnob {26 about l "" +STARTLINE T "<b><font color=#d1b364>Created by Livia Nunes - 2021 - v2.0 BETA</font></b>\n"}
 addUserKnob {26 site l "" +STARTLINE T "Visit <a href=\"http://www.livialivialivia.com\"><span style=\"color:#C8C8C8;\"><b>www.livialivialivia.com</a></b> for more tools and content"}
 addUserKnob {26 thanks l "" +STARTLINE T "<font color=#757575 size=2>A special thanks to Pedro Andrade for teaching me the\knowledge that made this tool possible</font>"}
}
