  knobChanged "\n\n#define variables\nntn = nuke.thisNode()\ng = nuke.thisGroup()\nk = nuke.thisKnob()\npremulted = ntn.knob('premulted').value()\n\n\nif k.name() == 'premulted':\n    if premulted == 1:\n        g.begin()\n        try:\n            nuke.toNode('Unpremulted_Image').knob('name').setValue('Premulted_Image')\n        except:\n            pass\n        g.end()\n    else:\n        g.begin()\n        try:\n            nuke.toNode('Premulted_Image').knob('name').setValue('Unpremulted_Image')\n        except:\n            pass\n        g.end()\n\n"
  xpos -1406
  ypos -283
