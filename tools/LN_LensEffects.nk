 addUserKnob {26 textAB l "<b>CHROMATIC ABERRATION</b>" T "\n"}
 addUserKnob {41 AberrationType l "Aberration Type" T _callbacks.AberrationType}
 addUserKnob {41 mix l Mix T KeymixAB.mix}
 addUserKnob {20 redscale l "red scale" n 1}
 addUserKnob {7 redxscale l "red x scale" R -0.2 0.2}
 addUserKnob {7 redyscale l "red y scale" R -0.2 0.2}
 addUserKnob {20 endGroup n -1}
