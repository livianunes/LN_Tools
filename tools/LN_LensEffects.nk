Group {
 name LN_LensEffects
 tile_color 0x3cb2ff
 note_font "Bitstream Vera Sans Bold"
 selected true
 xpos -548
 ypos -997
 addUserKnob {20 User}
 addUserKnob {22 set l "Set Defaults for Camera Format Type" T "def run():\n\n\n\n    ntn = nuke.thisNode()\n\n\n\n\n    redxScale = ntn.knob('redxscale')\n    redYscale = ntn.knob('redyscale')\n    greenxScale = ntn.knob('greenxscale')\n    greenYscale = ntn.knob('greenyscale')\n    bluexScale = ntn.knob('bluexscale')\n    blueYscale = ntn.knob('blueyscale')\n    sizeABmask = ntn.knob('size_ab_mask')\n\n\n\n\n\n    nuke.thisGroup().begin()\n                \n    cam = nuke.toNode('camType').knob('camera').getValue()\n    defBlur = nuke.toNode('defVigBlur').knob('size')\n    Blur_ab_mask = nuke.toNode('Blur_ab_mask').knob('size')\n    mixAB = nuke.toNode('KeymixAB').knob('mix')\n\n\n\n    nuke.thisGroup().end()\n\n\n\n\n\n    if cam == 1:\n        redxScale.setValue(0)\n        redYscale.setValue(0)\n        greenxScale.setValue(-0.001)\n        greenYscale.setValue(0)\n        bluexScale.setValue(0)\n        blueYscale.setValue(0)\n        mixAB.setValue(0.25) \n        defBlur.setValue(100)\n        Blur_ab_mask.setValue(300)\n        sizeABmask.setValue(0.36)\n        ntn.knob('defocus_type').setValue(0)\n        ntn.knob('DefocusAmount').setValue(1)\n        ntn.knob('defocusAspect').setValue(0.5)\n        ntn.knob('aspectDefMask').setValue(1)\n        ntn.knob('onFringe').setValue(0)\n        ntn.knob('vigON').setValue(1)\n        ntn.knob('vigIntensity').setValue(0.3)\n        ntn.knob('vigMask').setValue(0.53)\n        ntn.knob('vigAspect').setValue(1.1,0)\n        ntn.knob('vigAspect').setValue(1,1)\n        ntn.knob('vigBlur').setValue(100)\n\n\n                            \n    elif cam ==0 :\n\n\n\n        redxScale.setValue(0.002)\n        redYscale.setValue(0)\n        greenxScale.setValue(0)\n        greenYscale.setValue(0)\n        bluexScale.setValue(0)\n        blueYscale.setValue(0)\n        mixAB.setValue(0.43) \n        defBlur.setValue(100)\n        Blur_ab_mask.setValue(100)\n        ntn.knob('defocus_type').setValue(0)\n        ntn.knob('DefocusAmount').setValue(0)\n        ntn.knob('defocusAspect').setValue(0.5)\n        ntn.knob('aspectDefMask').setValue(1)\n        sizeABmask.setValue(0.32)\n        ntn.knob('onFringe').setValue(0)\n        ntn.knob('vigON').setValue(0)\n\n\n\nrun()\n\n\n\n\n" +STARTLINE}
 addUserKnob {6 UseGPU l "Use GPU if available" +STARTLINE}
 UseGPU true
 addUserKnob {26 spacer2 l "" +STARTLINE T ""}
 addUserKnob {26 textDefocus l "<b>LENS EDGE DEFOCUS</b>" T " \n"}
 addUserKnob {41 defocus_type l "Defocus Type" T _callbacks.defocus_type}
 addUserKnob {7 DefocusAmount l "Defocus Amount" R 0 20}
 DefocusAmount 1
 addUserKnob {7 defocusAspect l "Aspect Ratio" R 0 2}
 defocusAspect 0.5
