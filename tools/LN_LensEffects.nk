 NoOp {
  inputs 0
  name _callbacks
  knobChanged "ntn = nuke.thisNode()\n\nif nuke.thisKnob().name() == 'defocus_type':\n    \n        if ntn.knob('defocus_type').value() == 'Traditional':\n\n            nuke.thisParent().knob('DefocusAmount').setVisible(True)\n            nuke.thisParent().knob('defocusAspect').setVisible(True)\n            nuke.thisParent().knob('defocusVector').setVisible(False)\n        \n        else:\n\n            nuke.thisParent().knob('DefocusAmount').setVisible(False)\n            nuke.thisParent().knob('defocusAspect').setVisible(False)\n            nuke.thisParent().knob('defocusVector').setVisible(True)\n\n\nif nuke.thisKnob().name() == 'AberrationType':\n    \n        if ntn.knob('AberrationType').value() == 'Traditional':\n\n            nuke.thisParent().knob('chromaticVectorRed').setVisible(False)\n            nuke.thisParent().knob('abOffset').setVisible(False)\n            nuke.thisParent().knob('redscale').setVisible(True)\n            nuke.thisParent().knob('redxscale').setVisible(True)\n            nuke.thisParent().knob('redyscale').setVisible(True)\n            nuke.thisParent().knob('greenscale').setVisible(True)\n            nuke.thisParent().knob('greenxscale').setVisible(True)\n            nuke.thisParent().knob('greenyscale').setVisible(True)\n            nuke.thisParent().knob('bluescale').setVisible(True)\n            nuke.thisParent().knob('bluexscale').setVisible(True)\n            nuke.thisParent().knob('blueyscale').setVisible(True)            \n        \n        else:\n\n            nuke.thisParent().knob('chromaticVectorRed').setVisible(True)\n            nuke.thisParent().knob('abOffset').setVisible(True)\n            nuke.thisParent().knob('redscale').setVisible(False)\n            nuke.thisParent().knob('redxscale').setVisible(False)\n            nuke.thisParent().knob('redyscale').setVisible(False)\n            nuke.thisParent().knob('greenscale').setVisible(False)\n            nuke.thisParent().knob('greenxscale').setVisible(False)\n            nuke.thisParent().knob('greenyscale').setVisible(False)\n            nuke.thisParent().knob('bluescale').setVisible(False)\n            nuke.thisParent().knob('bluexscale').setVisible(False)\n            nuke.thisParent().knob('blueyscale').setVisible(False)      \n            \n                        \n   "
  xpos 823
  ypos 81
  hide_input true
  addUserKnob {20 User}
  addUserKnob {4 defocus_type l "Defocus Type" M {Traditional "Vector Based" "" ""}}
  addUserKnob {4 AberrationType l "Aberration Type" M {Traditional "Vector Based"}}
 }
