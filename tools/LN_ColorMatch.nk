NoOp {
inputs 0
name callbacks_
knobChanged "ntn = nuke.thisNode()\ntype = ntn.knob('Type').value()\n\nif nuke.thisKnob().name() == 'Type':\n    \n        if type == 'Minus-Plus' or type == 'Divide-Multiply':\n\n            nuke.thisParent().knob('HueMix').setVisible(False)\n            nuke.thisParent().knob('SaturationMix').setVisible(False)\n            nuke.thisParent().knob('ValueMix').setVisible(False)\n            nuke.thisParent().knob('ColorMix').setVisible(True)\n            nuke.thisParent().knob('blur').setVisible(True)\n            \n                        \n        else:\n            \n            nuke.thisParent().knob('HueMix').setVisible(True)\n            nuke.thisParent().knob('SaturationMix').setVisible(True)\n            nuke.thisParent().knob('ValueMix').setVisible(True)\n            nuke.thisParent().knob('ColorMix').setVisible(False)\n            nuke.thisParent().knob('blur').setVisible(False)\n            \n            \n            "
xpos 765
ypos -97
hide_input true
addUserKnob {20 User}
addUserKnob {4 Type M {Minus-Plus Divide-Multiply HSV ""}}
}
end_group
